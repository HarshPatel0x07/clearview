# Testnet key for the live Access Key panel. Faucet tokens only - this is
# Moderato, and a production build would sign in the user's wallet instead.
# Generate one by running `npm run prove`, which writes .secrets/testnet-account.json
VITE_TESTNET_KEY=0x...

# NOTE: this file belongs at the REPOSITORY ROOT, not in ui/.
# vite.config.ts sets root: 'ui', which would normally make Vite read
# ui/.env.local; envDir: '.' points it back here.
